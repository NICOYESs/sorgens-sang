{
  "name": "sorgens-sang",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npx quartz plugin install && node scripts/dansk.mjs && npx quartz build"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
